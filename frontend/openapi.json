          {
            "name": "ends_at",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Range end; no offset means studio time.",
              "title": "Ends At"
            },
            "description": "Range end; no offset means studio time."
          },
          {
            "name": "excluded_booking_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Leave out this booking, e.g. the one being edited.",
              "title": "Excluded Booking Id"
            },
            "description": "Leave out this booking, e.g. the one being edited."
          }
