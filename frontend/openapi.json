          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ends At"
          }
        },
        "type": "object",
        "required": [
          "booker_name",
          "equipment_ids",
          "starts_at",
          "ends_at"
        ],
        "title": "BookingCreateRequest"
      },
      "BookingEventResponse": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "actor_name": {
            "type": "string",
            "title": "Actor Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
