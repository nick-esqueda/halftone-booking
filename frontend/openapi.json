          "equipment_name"
        ],
        "title": "BookingItemResponse"
      },
      "BookingResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "booker_name": {
            "type": "string",
            "title": "Booker Name"
          },
