# Copy to .env to override defaults. Every API setting uses the BOOKING_ prefix.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=booking
BOOKING_STUDIO_TIMEZONE=America/Chicago
BOOKING_TIME_STEP_MINUTES=15
DB_PORT=5432

# Fill an empty database with random demo bookings (up to 2 months out) on start.
# Docker Compose turns this on; leave it off for production.
BOOKING_SEED_DEMO_BOOKINGS=true

# The booking assistant. Leave the key empty to switch the assistant off.
ANTHROPIC_API_KEY=
BOOKING_LLM_MODEL=claude-sonnet-5-5
BOOKING_LLM_EFFORT=low

# Logging. Levels: TRACE, DEBUG, INFO, WARNING, ERROR.
# Sinks: console, file (./logs/api.log), stdout-json (for deployments).
BOOKING_LOG_LEVEL=DEBUG
BOOKING_LOG_SINKS=console,file
# Per-area overrides, e.g. app.services=TRACE,sqlalchemy.engine=INFO
BOOKING_LOG_LEVELS=
# Log full assistant prompts and model replies at TRACE (they hold what people type).
BOOKING_LOG_LLM_CONTENT=false
