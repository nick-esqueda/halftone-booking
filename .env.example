# Copy to .env to override defaults. Every API setting uses the BOOKING_ prefix.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=booking
BOOKING_STUDIO_TIMEZONE=America/Chicago
BOOKING_TIME_STEP_MINUTES=15
DB_PORT=5432

# Logging. Levels: TRACE, DEBUG, INFO, WARNING, ERROR.
# Sinks: console, file (./logs/api.log), stdout-json (for deployments).
BOOKING_LOG_LEVEL=DEBUG
BOOKING_LOG_SINKS=console,file
# Per-area overrides, e.g. app.services=TRACE,sqlalchemy.engine=INFO
BOOKING_LOG_LEVELS=
